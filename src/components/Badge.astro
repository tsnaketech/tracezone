---
interface Props {
  variant?: 'neutral' | 'accent' | 'success' | 'warning' | 'danger' | undefined;
  mono?: boolean | undefined;
  title?: string | undefined;
}

const { variant = 'neutral', mono = false, title } = Astro.props;

const VARIANTS: Record<NonNullable<Props['variant']>, string> = {
  neutral: 'border-line bg-surface-2 text-muted',
  accent: 'border-accent/35 bg-accent-soft text-accent',
  success: 'border-success/35 bg-success-soft text-success',
  warning: 'border-warning/35 bg-warning-soft text-warning',
  danger: 'border-danger/35 bg-danger-soft text-danger',
};
---

<span
  title={title}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 text-xs leading-5 whitespace-nowrap',
    VARIANTS[variant],
    mono && 'tz-mono tracking-tight',
  ]}
>
  <slot />
</span>
