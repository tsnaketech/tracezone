---
import Card from '@/components/Card.astro';
import type { NameserverInfo } from '@/lib/lookup/types';

interface Props {
  nameservers: readonly NameserverInfo[];
}

const { nameservers } = Astro.props;
const count = nameservers.length;
---

<Card title="Nameservers" meta={count === 0 ? undefined : String(count)}>
  {count === 0 ? (
    <p class="text-[13px] text-subtle">No nameservers are delegated.</p>
  ) : (
    <ul class="divide-y divide-line/60">
      {nameservers.map((nameserver) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-1.5">
          <span class="tz-mono text-[13px] break-all text-fg">{nameserver.name}</span>
          {(nameserver.ipv4.length > 0 || nameserver.ipv6.length > 0) && (
            <span class="tz-mono text-xs text-subtle">
              {[...nameserver.ipv4, ...nameserver.ipv6].join(' · ')}
            </span>
          )}
        </li>
      ))}
    </ul>
  )}
</Card>
