---
interface Props {
  title: string;
  /** Small right-aligned annotation, e.g. a count. */
  meta?: string | undefined;
  class?: string | undefined;
}

const { title, meta, class: className } = Astro.props;
---

<section class:list={['tz-card overflow-hidden', className]}>
  <header class="flex items-baseline justify-between gap-3 border-b border-line px-4 py-2.5">
    <h2 class="text-[13px] font-semibold tracking-wide text-fg uppercase">{title}</h2>
    {meta !== undefined && <span class="tz-mono text-xs text-subtle">{meta}</span>}
  </header>
  <div class="px-4 py-3.5">
    <slot />
  </div>
</section>
