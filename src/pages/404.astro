---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchBar from '@/components/SearchBar.svelte';
---

<BaseLayout title="Not found" description="This page does not exist." noindex>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="tz-mono text-sm text-subtle">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-fg">This page does not exist</h1>
    <p class="mt-2 text-[15px] text-muted">Look up a domain instead.</p>
    <div class="mt-8">
      <SearchBar client:load size="sm" />
    </div>
  </div>
</BaseLayout>
